{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Vibe Coding Knowledge Base",
  "type": "object",
  "required": [
    "knowledge_base",
    "version",
    "scope",
    "risk_catalog",
    "goal_quality_gates"
  ],
  "properties": {
    "knowledge_base": {
      "type": "string"
    },
    "version": {
      "type": "string"
    },
    "scope": {
      "type": "object",
      "required": [
        "personas",
        "goals",
        "platforms"
      ],
      "properties": {
        "personas": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": [
              "id",
              "description",
              "experience_level"
            ],
            "properties": {
              "id": {
                "type": "string"
              },
              "description": {
                "type": "string"
              },
              "experience_level": {
                "type": "string",
                "enum": [
                  "none",
                  "low_to_medium",
                  "medium_to_high"
                ]
              }
            }
          }
        },
        "goals": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/goalId"
          }
        },
        "platforms": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        }
      }
    },
    "risk_catalog": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "title",
          "what_can_go_wrong",
          "likelihood",
          "impact",
          "applies_to_personas",
          "applies_to_platforms",
          "guardrails"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "what_can_go_wrong": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string"
            }
          },
          "likelihood": {
            "type": "string",
            "enum": [
              "low",
              "medium",
              "high"
            ]
          },
          "impact": {
            "type": "string",
            "enum": [
              "low",
              "medium",
              "high"
            ]
          },
          "applies_to_personas": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "enum": [
                "persona_beginner_senior",
                "persona_beginner_kid",
                "persona_hobbyist",
                "persona_advanced_builder"
              ]
            }
          },
          "applies_to_platforms": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "enum": [
                "web",
                "mobile_ios",
                "mobile_android",
                "desktop",
                "backend_api",
                "embedded_iot",
                "game_console",
                "wearable",
                "voice_assistant"
              ]
            }
          },
          "guardrails": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "goal_quality_gates": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "object",
        "required": [
          "minimum_requirements"
        ],
        "properties": {
          "minimum_requirements": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string"
            }
          }
        }
      },
      "propertyNames": {
        "$ref": "#/$defs/goalId"
      },
      "$comment": "Goal identifiers are shared through $defs.goalId; update that enum when adding new goals."
    }
  },
  "$defs": {
    "goalId": {
      "type": "string",
      "enum": [
        "hobby_project",
        "personal_utility",
        "state_of_the_art_product"
      ]
    }
  }
}
