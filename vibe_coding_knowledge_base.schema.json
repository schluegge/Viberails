{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.local/vibe_coding_knowledge_base.schema.json",
  "title": "Vibe Coding Knowledge Base",
  "type": "object",
  "required": [
    "knowledge_base",
    "version",
    "scope",
    "risk_catalog",
    "goal_quality_gates"
  ],
  "properties": {
    "knowledge_base": {
      "type": "string"
    },
    "version": {
      "type": "string"
    },
    "scope": {
      "type": "object",
      "required": ["personas", "goals", "platforms"],
      "properties": {
        "personas": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["id", "description", "experience_level"],
            "properties": {
              "id": { "type": "string" },
              "description": { "type": "string" },
              "experience_level": { "type": "string" }
            }
          }
        },
        "goals": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string" }
        },
        "platforms": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string" }
        }
      }
    },
    "risk_catalog": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "title",
          "what_can_go_wrong",
          "likelihood",
          "impact",
          "applies_to_personas",
          "applies_to_platforms",
          "guardrails"
        ],
        "properties": {
          "id": { "type": "string" },
          "title": { "type": "string" },
          "what_can_go_wrong": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string" }
          },
          "likelihood": { "type": "string" },
          "impact": { "type": "string" },
          "applies_to_personas": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string" }
          },
          "applies_to_platforms": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string" }
          },
          "guardrails": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string" }
          }
        }
      }
    },
    "goal_quality_gates": {
      "type": "object",
      "required": ["hobby_project", "personal_utility", "state_of_the_art_product"],
      "additionalProperties": {
        "type": "object",
        "required": ["minimum_requirements"],
        "properties": {
          "minimum_requirements": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string" }
          }
        }
      }
    }
  }
}
